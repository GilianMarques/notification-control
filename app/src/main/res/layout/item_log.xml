<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="@drawable/back_container"
    android:clickable="true"
    android:elevation="2dp"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:padding="16dp">

    <View
        android:id="@+id/view_level_indicator"
        android:layout_width="4dp"
        android:layout_height="0dp"
        android:layout_marginEnd="12dp"
        android:background="?colorAccent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_log_message_expanded"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:fontFamily="monospace"
        android:lineSpacingExtra="2dp"
        android:textColor="?colorOnBackground"
        android:textSize="13sp"
        app:layout_constraintStart_toEndOf="@+id/view_level_indicator"
        app:layout_constraintTop_toTopOf="@+id/view_level_indicator"
        tools:text="Application started successfully with configuration: debug=true, notifications=enabled, background_sync=true, auto_update=false, theme=dark" />


</androidx.constraintlayout.widget.ConstraintLayout>