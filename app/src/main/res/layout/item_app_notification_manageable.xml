<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp"
    android:transitionGroup="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/back_container"
        android:foreground="?attr/selectableItemBackground"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_app_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/back_circle"
            android:backgroundTint="?colorPrimary"
            android:padding="6dp"
            app:layout_constraintBottom_toBottomOf="@id/tv_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_title"
            app:srcCompat="@drawable/vec_app"
            app:tint="?colorOnPrimary" />


        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:drawablePadding="8dp"
            android:fontFamily="@font/urbanist_extrabold"
            android:maxLines="3"
            android:padding="4dp"
            android:textAlignment="viewStart"
            android:textSize="16sp"
            android:transitionName="not_title"
            app:drawableTint="?colorPrimary"
            app:layout_constraintEnd_toStartOf="@id/iv_menu"
            app:layout_constraintStart_toEndOf="@id/iv_app_icon"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Whatsapp" />


        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_menu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="-6dp"
            android:padding="14dp"
            app:layout_constraintBottom_toBottomOf="@id/tv_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_title"
            app:srcCompat="@drawable/vec_menu" />


        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_large_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:paddingStart="4dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@id/tv_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            tools:srcCompat="@drawable/vec_open_app"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:maxLines="20"
            android:paddingStart="4dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:textAlignment="gravity"
            android:textSize="14sp"
            android:transitionName="not_content"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_large_icon"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            tools:text="Conteudo da notificação\nbla bla bla bla...bla bla bla...bla bla bla...bla bla bla...bla bla bla...bla bla bla...bla bla bla...bla bla bla...bla bla bla...bla bla bla..."
            tools:visibility="visible" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/bottomBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierAllowsGoneWidgets="true"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="tv_content,iv_large_icon" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:drawablePadding="8dp"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/vec_info_small"
            app:drawableTint="?attr/colorPrimary"
            app:layout_constraintEnd_toStartOf="@id/ll_iv_types"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/bottomBarrier"
            tools:text="Adiada para ..."
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/ll_iv_types"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@id/tv_status"
            app:layout_constraintEnd_toEndOf="parent"
            android:paddingTop="8dp"
            app:layout_constraintTop_toTopOf="@id/tv_status">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_ongoing"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@string/Notifica_o_persistente"
                android:padding="6dp"
                android:visibility="gone"
                app:srcCompat="@drawable/vec_ongoing"
                app:tint="?colorPrimary"
                tools:visibility="visible" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_dismissible"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@string/Notifica_o_dispens_vel"
                android:padding="6dp"
                android:visibility="gone"
                app:srcCompat="@drawable/vec_dismiss"
                app:tint="?colorPrimary"
                tools:visibility="visible" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

